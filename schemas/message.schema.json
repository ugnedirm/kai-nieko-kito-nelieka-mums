{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadvault.example/schemas/1/message.schema.json",
  "title": "Message (full mode)",
  "description": "One line of messages.jsonl. Chained per branch. Edits are new records with `amends` set; the original is never rewritten.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version", "type", "id", "thread_id", "branch_id", "seq", "role",
    "author", "created_at", "content", "provenance", "prev_hash", "hash"
  ],
  "properties": {
    "spec_version": { "$ref": "common.schema.json#/$defs/spec_version" },
    "type": { "const": "message" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "thread_id": { "$ref": "common.schema.json#/$defs/id" },
    "branch_id": { "$ref": "common.schema.json#/$defs/id" },
    "seq": { "type": "integer", "minimum": 0 },
    "role": { "enum": ["user", "assistant", "system", "tool"] },
    "author": { "$ref": "common.schema.json#/$defs/author" },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "content": { "type": "string", "maxLength": 200000 },
    "file_refs": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "common.schema.json#/$defs/hash" }
    },
    "amends": { "$ref": "common.schema.json#/$defs/id" },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" },
    "prev_hash": { "$ref": "common.schema.json#/$defs/nullable_hash" },
    "hash": { "$ref": "common.schema.json#/$defs/hash" },
    "signature": { "$ref": "common.schema.json#/$defs/signature" }
  }
}
