{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadvault.example/schemas/1/tombstone.schema.json",
  "title": "Tombstone",
  "description": "Marks a file or message as deliberately removed (forget/expiry). Lives in the chain, so verify can tell a legitimate removal from tampering.",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "type", "thread_id", "branch_id", "target", "removed_at", "reason", "prev_hash", "hash"],
  "properties": {
    "spec_version": { "$ref": "common.schema.json#/$defs/spec_version" },
    "type": { "const": "tombstone" },
    "thread_id": { "$ref": "common.schema.json#/$defs/id" },
    "branch_id": { "$ref": "common.schema.json#/$defs/id" },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sha256"],
          "properties": {
            "kind": { "const": "file" },
            "sha256": { "$ref": "common.schema.json#/$defs/hash" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "message" },
            "id": { "$ref": "common.schema.json#/$defs/id" }
          }
        }
      ]
    },
    "removed_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "reason": { "enum": ["user-forget", "expired", "policy"] },
    "prev_hash": { "$ref": "common.schema.json#/$defs/nullable_hash" },
    "hash": { "$ref": "common.schema.json#/$defs/hash" },
    "signature": { "$ref": "common.schema.json#/$defs/signature" }
  }
}
