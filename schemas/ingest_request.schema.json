{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadvault.example/schemas/1/ingest_request.schema.json",
  "title": "Extension ingest request",
  "description": "POST /v1/ingest on the local vault service (127.0.0.1 only, Authorization: Bearer <per-install token>). The vault assigns versions, hashes and signatures; the extension only supplies content. The vault must run scanners and policy checks before storing, and the payload is untrusted input.",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "type", "request_id", "client", "captured_at", "user_reviewed", "target", "payload"],
  "properties": {
    "spec_version": { "$ref": "common.schema.json#/$defs/spec_version" },
    "type": { "const": "ingest_request" },
    "request_id": { "$ref": "common.schema.json#/$defs/id" },
    "captured_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "user_reviewed": {
      "description": "True only if the user saw and approved this content in the extension's review screen.",
      "type": "boolean"
    },
    "acknowledged_findings": {
      "description": "True only if the user saw the scanner findings from a previous needs_confirmation response and chose to proceed. Never overrides a blocking finding.",
      "type": "boolean"
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_id", "version", "adapter"],
      "properties": {
        "client_id": { "type": "string", "maxLength": 128 },
        "version": { "type": "string", "maxLength": 32 },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["site", "version"],
          "properties": {
            "site": { "enum": ["chatgpt", "claude"] },
            "version": { "type": "string", "maxLength": 32 }
          }
        }
      }
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["thread_id"],
          "properties": { "thread_id": { "$ref": "common.schema.json#/$defs/id" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["new_thread"],
          "properties": {
            "new_thread": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "mode"],
              "properties": {
                "title": { "type": "string", "minLength": 1, "maxLength": 200 },
                "mode": { "enum": ["handover", "full"] }
              }
            }
          }
        }
      ]
    },
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "content", "metadata"],
          "properties": {
            "kind": { "const": "handover" },
            "content": { "$ref": "handover.schema.json#/$defs/content" },
            "metadata": { "$ref": "handover.schema.json#/$defs/metadata" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "messages"],
          "properties": {
            "kind": { "const": "messages" },
            "messages": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["role", "author", "created_at", "content"],
                "properties": {
                  "role": { "enum": ["user", "assistant", "system", "tool"] },
                  "author": { "$ref": "common.schema.json#/$defs/author" },
                  "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
                  "content": { "type": "string", "maxLength": 200000 },
                  "file_refs": {
                    "type": "array",
                    "maxItems": 100,
                    "items": { "$ref": "common.schema.json#/$defs/hash" }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "file"],
          "properties": {
            "kind": { "const": "file" },
            "file": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "media_type", "size", "data_base64"],
              "properties": {
                "name": { "type": "string", "minLength": 1, "maxLength": 255 },
                "media_type": { "type": "string", "maxLength": 127 },
                "size": { "type": "integer", "minimum": 0, "maximum": 52428800 },
                "data_base64": { "type": "string" }
              }
            }
          }
        }
      ]
    }
  }
}
