{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadvault.example/schemas/1/manifest.schema.json",
  "title": "Thread manifest",
  "description": "manifest.json at the root of a thread folder. mode=handover stores handovers + files only; mode=full also stores messages.jsonl.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version", "type", "thread_id", "title", "mode", "created_at",
    "updated_at", "current_branch", "branches", "files"
  ],
  "properties": {
    "spec_version": { "$ref": "common.schema.json#/$defs/spec_version" },
    "type": { "const": "manifest" },
    "thread_id": { "$ref": "common.schema.json#/$defs/id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "mode": { "enum": ["handover", "full"] },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "updated_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "expires_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "current_branch": { "$ref": "common.schema.json#/$defs/id" },
    "branches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["branch_id", "head_hash"],
        "properties": {
          "branch_id": { "$ref": "common.schema.json#/$defs/id" },
          "head_hash": { "$ref": "common.schema.json#/$defs/nullable_hash" }
        }
      }
    },
    "files": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/file_ref" }
    },
    "signing_keys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "public_key"],
        "properties": {
          "key_id": { "type": "string", "maxLength": 128 },
          "public_key": { "type": "string", "maxLength": 128 }
        }
      }
    },
    "encryption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "scheme": { "enum": ["age"] }
      }
    }
  }
}
