{
  "manifest_version": 3,
  "name": "When nothing else is left",
  "version": "0.1.0",
  "description": "Save a reviewed handover (and optionally the conversation) from ChatGPT or Claude into your local vault.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "src/lib/constants.js",
        "src/lib/util.js",
        "src/lib/files.js",
        "src/lib/handover.js",
        "src/lib/limits.js",
        "src/adapters/base.js",
        "src/adapters/chatgpt.js",
        "src/adapters/claude.js",
        "src/adapters/index.js",
        "src/generated/prompt.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "When nothing else is left",
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src http://127.0.0.1:*"
  },
  "background": {
    "scripts": [
      "src/lib/constants.js",
      "src/lib/util.js",
      "src/lib/handover.js",
      "src/lib/ingest.js",
      "src/background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{a6f74950-91e6-454e-b5d1-e46c63adfc26}",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
