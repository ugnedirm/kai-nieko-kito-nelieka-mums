{
  "manifest_version": 3,
  "name": "threadvault",
  "version": "0.1.0",
  "description": "Save a reviewed handover (and optionally the conversation) from ChatGPT or Claude into your local threadvault.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "src/lib/constants.js",
        "src/lib/util.js",
        "src/lib/handover.js",
        "src/lib/limits.js",
        "src/adapters/base.js",
        "src/adapters/chatgpt.js",
        "src/adapters/claude.js",
        "src/adapters/index.js",
        "src/generated/prompt.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "threadvault",
    "default_popup": "pages/popup.html"
  },
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src http://127.0.0.1:*"
  },
  "minimum_chrome_version": "114",
  "background": {
    "service_worker": "src/background.js"
  }
}
